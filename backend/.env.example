APP_NAME="Nexus Commerce API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database (PostgreSQL) ─────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=nexus_commerce
DB_USERNAME=nexus_user
DB_PASSWORD=

# ─── Session & Broadcast ───────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=gcs
QUEUE_CONNECTION=redis

# ─── Cache ─────────────────────────────────────────
CACHE_STORE=redis

# ─── Redis ─────────────────────────────────────────
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

# ─── Mail ──────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@nexuscommerce.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── GCP ───────────────────────────────────────────
GCP_PROJECT_ID=
GCP_STORAGE_BUCKET=
GCP_STORAGE_PATH_PREFIX=products

# ─── Sanctum (CORS / Auth) ─────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost:3000
SESSION_DOMAIN=localhost

# ─── Security ──────────────────────────────────────
# Never put real values here — use .env for local, GCP Secret Manager for production
JWT_SECRET=